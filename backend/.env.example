# Copy to backend/.env and fill in. Never commit the real .env.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

ENVIRONMENT=development
LOG_LEVEL=INFO

# Public HTTPS URL that ElevenLabs' servers use to reach this backend
# (tool webhooks + Vertex LLM proxy). In development: a tunnel to http://localhost:8000.
# dev.ps1 fills this in automatically from ngrok.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
# Optional: your free static ngrok domain (ngrok dashboard > Domains), e.g. health-ai.ngrok-free.app.
# With it the tunnel URL never changes, so the agent never needs re-pointing.
NGROK_DOMAIN=
FRONTEND_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://healthcare:healthcare@localhost:5433/healthcare

# --- Shared secrets (required; dev defaults are refused when ENVIRONMENT=production)
TOOL_SECRET=change-me-random
LLM_PROXY_SECRET=change-me-random
ADMIN_TOKEN=change-me-random

# --- Clinic (sample values - replace with your clinic's details)
CLINIC_NAME=Health AI
CLINIC_ADDRESS=14 Riverside Walk, London SE1 9QQ
CLINIC_PHONE=020 7946 0000
CLINIC_EMAIL=hello@healthai.example
ASSISTANT_NAME=Sophie

# --- ElevenLabs
ELEVENLABS_API_KEY=
# Filled automatically by `python -m app.cli setup-agent` (kept in .elevenlabs-state.json);
# set here only to pin a specific agent.
ELEVENLABS_AGENT_ID=
# Optional: pin a voice. Otherwise setup-agent picks a British female voice from your library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2
# Secret from ElevenLabs > Agents > Settings > Webhooks (post-call webhook). Optional.
ELEVENLABS_WEBHOOK_SECRET=
# Match your plan's concurrency (Free = 4, Starter = 6, Creator = 10, Pro = 20).
MAX_CONCURRENT_SESSIONS=4
ELEVENLABS_DAILY_CONVERSATION_LIMIT=200
STORE_TRANSCRIPTS=false

# --- Vertex AI (custom LLM)
VERTEX_PROJECT_ID=your-gcp-project-id
# europe-west2 = London. Use "global" if your chosen model isn't available in London.
VERTEX_LOCATION=europe-west2
VERTEX_MODEL=google/gemini-3.5-flash
# minimal = fastest replies (recommended for voice); low/medium/high think longer.
VERTEX_REASONING_EFFORT=minimal
# Leave empty to use your gcloud login (gcloud auth application-default login),
# or set a service-account JSON key with the "Vertex AI User" role (e.g. for servers).
VERTEX_CREDENTIALS_FILE=

# --- Google Calendar
GOOGLE_CALENDAR_ENABLED=false
# Leave empty to use your gcloud login (it needs the Calendar scope:
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/cloud-platform)
# or set a service-account JSON key; share each clinician's calendar with its email
# ("Make changes to events"), or use domain-wide delegation + GOOGLE_IMPERSONATE_USER.
# Then run:  python -m app.cli setup-calendars   (creates + links one calendar per clinician)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_IMPERSONATE_USER=

# --- Scheduling rules
SLOT_STEP_MINUTES=15
MIN_NOTICE_MINUTES=120
BOOKING_HORIZON_DAYS=60
LATE_CANCELLATION_HOURS=24

# --- Phone line, text messages and the SOS emergency line (Twilio). Optional: leave empty to keep them off.
# Twilio Console > Account info. The auth token also verifies that webhooks really come from Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Console > API keys & tokens > Create API key (Standard). Needed for calls from the website (SOS, reception).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The clinic's Twilio number in E.164 format, e.g. +442079460000. setup-agent connects it to Sophie.
TWILIO_PHONE_NUMBER=
# Optional data residency, e.g. TWILIO_REGION=ie1 and TWILIO_EDGE=dublin. Empty = Twilio's default (US).
TWILIO_REGION=
TWILIO_EDGE=
# Created by setup-agent for calls from the website; set only to use an existing TwiML app.
TWILIO_TWIML_APP_SID=
TWILIO_VALIDATE_SIGNATURES=true
# Text confirmations when an appointment is booked, moved or cancelled.
SMS_ENABLED=true
# Optional sender name instead of the number, e.g. HealthAI (up to 11 letters/digits; patients can't reply).
SMS_SENDER=
# Where "can I speak to someone" calls go, e.g. +442079460001. Empty = Sophie offers a callback instead.
RECEPTION_PHONE_NUMBER=
# Sophie rings patients the evening before their appointment, from this hour (clinic time).
REMINDER_CALLS_ENABLED=false
REMINDER_CALL_HOUR=17
REMINDER_CALL_SPACING_SECONDS=90
# SOS: how long each doctor's phone rings, and how long the patient waits before being told to call 999.
SOS_RING_SECONDS=30
SOS_MAX_WAIT_SECONDS=90
SOS_STARTS_PER_IP_PER_HOUR=3
