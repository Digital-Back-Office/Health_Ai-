# Docker Compose env (copy to .env on the server). Full option list: backend/.env.example
ENVIRONMENT=production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://health-ai.digitalbackoffice.co.uk
FRONTEND_ORIGINS=https://health-ai.digitalbackoffice.co.uk

# Used by compose for the db container and the DATABASE_URL it injects.
POSTGRES_PASSWORD=change-me-random

# python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_SECRET=change-me-random
LLM_PROXY_SECRET=change-me-random
ADMIN_TOKEN=change-me-random

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# On a GCE VM leave the credential files empty: the VM's attached service account is used.
VERTEX_PROJECT_ID=your-gcp-project-id
# europe-west2 = London. Gemini 3.5 Flash also runs in europe-west3 (Frankfurt), used as the fallback.
VERTEX_LOCATION=europe-west2
# If the main region is busy ("too many requests") or times out, retry here (its own quota).
VERTEX_FALLBACK_LOCATION=europe-west3
VERTEX_MODEL=google/gemini-3.5-flash
VERTEX_REASONING_EFFORT=minimal
VERTEX_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ENABLED=false

# --- Phone line, texts and the SOS line (Twilio). Leave empty to keep them off.
# Give production its own Twilio number: whichever setup-agent ran last owns the number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
RECEPTION_PHONE_NUMBER=
SMS_ENABLED=true
SMS_SENDER=
REMINDER_CALLS_ENABLED=false
REMINDER_CALL_HOUR=17
SOS_RING_SECONDS=30
SOS_MAX_WAIT_SECONDS=90
SOS_STARTS_PER_IP_PER_HOUR=3
