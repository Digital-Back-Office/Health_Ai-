# Docker Compose env (copy to .env on the server). Full option list: backend/.env.example
ENVIRONMENT=production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://health-ai.digitalbackoffice.co.uk
FRONTEND_ORIGINS=https://health-ai.digitalbackoffice.co.uk

# Used by compose for the db container and the DATABASE_URL it injects.
POSTGRES_PASSWORD=change-me-random

# python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_SECRET=change-me-random
LLM_PROXY_SECRET=change-me-random
ADMIN_TOKEN=change-me-random

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# On a GCE VM leave the credential files empty: the VM's attached service account is used.
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=europe-west2
VERTEX_MODEL=google/gemini-3.5-flash
VERTEX_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ENABLED=false
